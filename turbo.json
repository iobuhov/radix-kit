{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",

  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "m:build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "m:design-props": {
      "cache": false,
      "dependsOn": ["^__transit_node__", "task-utils#build"]
    },
    "radix-ui-styles#dev": {
      "dependsOn": ["task-utils#build"]
    },
    "__transit_node__": {}
  }
}
